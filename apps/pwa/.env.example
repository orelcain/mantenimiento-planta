# Variables de entorno para Firebase
# Copiar este archivo como .env.local y completar con tus valores

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# App Check — reCAPTCHA Enterprise site key (pública por diseño, valida origen)
# Crear en https://console.cloud.google.com/security/recaptcha
VITE_RECAPTCHA_SITE_KEY=

# Opcional: usar emuladores locales en desarrollo
VITE_USE_EMULATORS=false

# Google OAuth client ID (público por diseño)
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────
# IMPORTANTE — NO declarar VITE_*_API_KEY de IA en el cliente.
# Toda llamada a Groq / Gemini / Deepseek pasa por Cloud Functions proxy
# (groqProxy / geminiProxy / deepseekProxy) que leen las keys desde GCP
# Secret Manager. Si declarás la variable como VITE_* en build time, Vite
# la inlinea literalmente en el bundle público y queda expuesta a cualquiera.
# ─────────────────────────────────────────────────────────────────────
