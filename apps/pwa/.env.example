# Variables de entorno para Firebase
# Copiar este archivo como .env.local y completar con tus valores

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: usar emuladores locales en desarrollo
VITE_USE_EMULATORS=false

VITE_GOOGLE_CLIENT_ID=

VITE_GROQ_API_KEY=

# Gemini 2.0 Flash (Google) — obtener gratis en https://aistudio.google.com/apikey
# Si se configura, ARIA usa Gemini como motor principal (mejor razonamiento)
# Si no, usa Groq como fallback
VITE_GEMINI_API_KEY=
