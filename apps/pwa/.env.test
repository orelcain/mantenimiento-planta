# Valores FALSOS solo para correr los tests.
#
# `src/services/firebase.ts` llama a `getAuth()` al importarse y revienta con
# `auth/invalid-api-key` si no hay apiKey. Como media app importa firebase de
# forma transitiva, eso hacia que 11 archivos de test murieran AL IMPORTAR:
# vitest los contaba como "1 failed" y sus tests no corrian nunca. El bug
# quedaba invisible porque CI no corria vitest.
#
# Vite carga este archivo solo en modo test, asi que no afecta al build ni al
# dev server. No hay ningun secreto aca: son cadenas inventadas con el formato
# que el SDK necesita para inicializar sin quejarse. Los tests que de verdad
# tocan Firestore siguen mockeando `@/services/firebase`.
VITE_FIREBASE_API_KEY=test-api-key-no-real
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://test.firebaseio.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
