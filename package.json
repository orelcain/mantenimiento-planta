{
  "name": "mantenimiento-industrial",
  "version": "2.64.0",
  "private": true,
  "description": "PWA para levantamiento de incidencias y mantenimiento industrial",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "preview": "turbo run preview",
    "clean": "turbo run clean && rm -rf node_modules",
    "sync:version:pwa": "node scripts/sync-pwa-version.mjs",
    "release:pwa:verify": "node scripts/verify-pwa-release-sync.mjs",
    "release:pwa:finalize": "pnpm -C apps/pwa run sync:version && pnpm run release:pwa:verify && pnpm -C apps/pwa exec tsc --noEmit && pnpm -C apps/pwa lint && pnpm -C apps/pwa build",
    "deploy": "node scripts/deploy.mjs",
    "seed:user": "node scripts/seed_user_profile.js",
    "seed:user:help": "node scripts/seed_user_profile.js --help",
    "sync:equipment": "node scripts/sync_equipment_from_hierarchy.js",
    "sync:equipment:help": "node scripts/sync_equipment_from_hierarchy.js --help",
    "migrate:gantt:default-project": "node scripts/migrate_gantt_default_project.js --apply"
  },
  "devDependencies": {
    "mammoth": "^1.11.0",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "xlsx": "^0.18.5"
  }
}
