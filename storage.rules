rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Teléfono con PASE DE BITÁCORA (QR + PIN, 16-09-2026): no es una sesión de
    // la app. Solo entra a bitacora/ (ver abajo). Aquí no se puede consultar su
    // documento de dispositivo (el cross-service deniega en prod, ver /models3d):
    // si un supervisor lo quita, la función deshabilita la cuenta y su token
    // deja de servir en menos de una hora.
    function tienePaseBitacora() {
      return request.auth != null && request.auth.token.get('pase_bitacora', false) == true;
    }
    function sesionApp() {
      return request.auth != null && !tienePaseBitacora();
    }
    // Rol del usuario (cross-service: lee el doc de Firestore del caller).
    // Solo se usa donde el path es explícitamente admin-only (ver /maps/).
    function isAdmin() {
      return sesionApp()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }
    // Lectura SOLO autenticados NO anónimos (la Mini App de Telegram usa
    // custom token de mintTelegramAuthToken; anónimos cerrados 2026-07-05).
    // Excepciones públicas deliberadas más abajo: models3d, baader200-images.
    match /{allPaths=**} {
      allow read: if sesionApp()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Planos de Aguas — fotos referenciales por bajada (PWA + QR)
    // Subida/borrado por usuario autenticado; el QR público las ve vía el token
    // del downloadURL guardado en Firestore (planosAguas/main.photos).
    // {allPaths=**} para cubrir la subcarpeta por bajada: planosAguas/{id}/{k}.jpg
    match /planosAguas/{allPaths=**} {
      allow write: if sesionApp()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Hojas de planos eléctricos servidas desde Storage (los que no caben en
    // el repo, p.ej. GEA ~400 MB en SVG). Lectura pública deliberada: el
    // Centro de Aprendizaje es público, igual que models3d.
    match /planos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos colgadas sobre el plano eléctrico: el automático real, la bornera,
    // cómo quedó el cableado. Mismo límite que planosAguas.
    match /planosElectricos/{allPaths=**} {
      allow write: if sesionApp()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Fotos que el técnico cuelga sobre una figura del manual de la BAADER 142
    // (módulo Perilla 5). Mismo límite y forma que planosAguas/planosElectricos.
    match /baader142Notas/{allPaths=**} {
      allow write: if sesionApp()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Fotos de incidencias (max 10MB, solo imágenes)
    // Delete: sin esta línea NINGÚN cliente podía borrar un objeto acá (403
    // comprobado con token de admin el 08-09-2026) y cualquier subida fallida
    // o de prueba quedaba huérfana para siempre. Mismo criterio que
    // machines/.../repuestos y planosAguas: sesión no anónima. No se puede
    // exigir isAdmin(): ver la nota en /models3d (el cross-service deniega).
    match /incidents/{incidentId}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Fotos de la bitácora de turno: bitacora/{turnoId}/{eventoId}/{archivo}
    // (3 segmentos después de `bitacora`, igual que fotosBitacora.ts).
    // Delete para cualquier sesión no anónima: la bitácora es compartida y al
    // cancelar un evento nuevo se limpian las fotos ya subidas. No se puede
    // exigir isAdmin(): ver la nota en /models3d (el cross-service deniega).
    match /bitacora/{turnoId}/{eventoId}/{fileName} {
      // El pase de bitácora sube, ve (getDownloadURL) y limpia sus fotos aquí.
      allow read: if tienePaseBitacora();
      allow write: if ((sesionApp() && request.auth.token.firebase.sign_in_provider != 'anonymous')
            || tienePaseBitacora())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if (sesionApp() && request.auth.token.firebase.sign_in_provider != 'anonymous')
        || tienePaseBitacora();
    }

    // Fotos de evidencias fotográficas (before/after)
    match /evidence/{evidenceId}/{type}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Fotos de equipos
    match /equipment/{equipmentId}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Repuestos en maquinas
    match /machines/{machineId}/repuestos/{repuestoId}/{type}/{fileName} {
      allow create, update: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Manuales PDF de máquinas (max 50MB)
    match /machines/{machineId}/manuales/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf');
      allow delete: if sesionApp();
    }

    // Infografías de máquinas
    match /machines/{machineId}/infografias/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Repuestos legacy (Baader 200)
    match /repuestos/{repuestoId}/{type}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos reales de repuestos (uploadRepuestoFoto):
    // repuestos/{machineId}/{repuestoId}/fotos/{fileName} — 4 segmentos, no lo
    // cubre la regla legacy de arriba (3 segmentos) ni /machines/...
    match /repuestos/{machineId}/{repuestoId}/{type}/{fileName} {
      allow create, update: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Fotos de ítems de bodega (uploadBodegaPhoto): bodega/{codigoSAP}/fotos/{fileName}
    match /bodega/{codigoSAP}/{type}/{fileName} {
      allow create, update: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp();
    }

    // Fotos de usuarios
    match /users/{userId}/{fileName} {
      allow write: if sesionApp() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Planos de planta (solo admin) - subcarpetas por ubicación.
    // El comentario ya decía "solo admin" pero la regla no lo exigía (cualquier
    // autenticado podía escribir) — corregido para que coincida con el intent:
    // solo MapsAdminPage.tsx (ruta /admin) sube acá.
    match /maps/{locationId}/{fileName} {
      allow write: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Uploads Grader (Excel)
    match /graderUploads/{uploadId}/{fileName} {
      allow create, update: if sesionApp()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')
            || request.resource.contentType.matches('application/vnd.ms-excel')
            || request.resource.contentType.matches('text/csv'));
      allow read, delete: if sesionApp();
    }
    
    // Fotos de inspecciones (items de inspección)
    match /inspections/{inspectionId}/{itemId}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de comentarios Gantt
    match /gantt/{taskId}/comments/{commentDraftId}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Firmas digitales
    match /incidents/{incidentId}/signatures/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Modelos 3D — lectura pública para QR.
    // isAdmin() depende de roles/firebaserules.firestoreServiceAgent en el agente
    // service-1019421112530@firebase-rules.iam.gserviceaccount.com (otorgar antes del merge).
    // Ante un 403 para un admin con archivo válido, comprobar ese rol IAM:
    // sin él falla firestore.get() cross-service; los mocks no verifican IAM.

    // Fotos de anotaciones: edición compartida por usuarios de la app, no solo admins
    // (Visor3DViewerPage.tsx: handleSubmitAnnotation). Excluir sesiones anónimas.
    // Ruta real: models3d/{modelId}/annotations/{annotationId}/{photoId}.{ext}
    match /models3d/{modelId}/annotations/{allPaths=**} {
      allow read: if true;
      allow create, update: if sesionApp()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if sesionApp()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // El archivo del modelo. Ruta real: models3d/{modelId}/{fileName}
    match /models3d/{modelId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('model/.*')
            || request.resource.contentType.matches('application/octet-stream'));
      // deleteModel3D y rollback de uploadModel3D: el admin puede borrar aunque
      // no se haya creado el doc del modelo; no se consulta ese doc para autorizar.
      allow delete: if isAdmin();
    }

    // Imágenes Baader 200 — Manual de Ajustes (lectura pública, subida autenticados, max 10MB)
    match /baader200-images/{fileName} {
      allow read: if true;
      allow write: if sesionApp()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Manuales técnicos — planta/área/equipo/repuesto (F4 2026-05-04)
    match /manuales/{ownerType}/{ownerId}/{fileName} {
      allow write: if sesionApp()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
      allow delete: if sesionApp();
    }
  }
}
