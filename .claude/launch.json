{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pwa-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/pwa",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "propuestas-html",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "5500",
        "."
      ],
      "port": 5500
    },
    {
      "name": "mockups",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "5501",
        "apps/pwa/public/dev-mockups"
      ],
      "port": 5501
    },
    {
      "name": "pwa-grader-vivo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/pwa",
      "port": 5173,
      "env": {
        "VITE_FIREBASE_API_KEY": "falsa",
        "VITE_FIREBASE_AUTH_DOMAIN": "falsa.firebaseapp.com",
        "VITE_FIREBASE_PROJECT_ID": "falsa",
        "VITE_FIREBASE_STORAGE_BUCKET": "falsa.appspot.com",
        "VITE_FIREBASE_MESSAGING_SENDER_ID": "1",
        "VITE_FIREBASE_APP_ID": "1:1:web:1"
      }
    }
  ]
}