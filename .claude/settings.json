{
  "model": "claude-opus-4-6",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-greeting.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/shoplogix-tests.cjs\"",
            "timeout": 120,
            "statusMessage": "Tests del sync de Shoplogix…"
          }
        ]
      }
    ]
  }
}
