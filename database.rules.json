{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null || newData.child('online').exists()"
      }
    },

    "sensors": {
      "$equipmentId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "online": {
          ".write": "auth != null || newData.isBoolean()"
        },
        "lastSeen": {
          ".write": "auth != null || newData.isNumber()"
        },
        "equipmentId": {
          ".write": "auth != null || newData.isString()"
        },

        "temperatura": {
          ".write": "auth != null || (newData.child('value').isNumber() && newData.child('timestamp').isNumber())"
        },
        "humedad": {
          ".write": "auth != null || (newData.child('value').isNumber() && newData.child('timestamp').isNumber())"
        },

        "readings": {
          ".indexOn": ["timestamp"],
          "$readingId": {
            ".write": "auth != null || (newData.child('timestamp').isNumber() && newData.child('temperature').isNumber() && newData.child('humidity').isNumber())"
          }
        }
      }
    }
  }
}
